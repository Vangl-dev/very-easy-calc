# Very Easy Calc — exemplo de configuração
# Copie para .env e ajuste. NUNCA versione o arquivo .env real.

# Identificação
APP_NAME=Very Easy Calc
APP_VERSION=1.0.0

# Banco (SQLite por padrão; a arquitetura permite PostgreSQL)
# Comente para usar o banco padrão do projeto: database/very_easy_calc.db.
# Descomente apenas se souber o caminho absoluto — caminho relativo depende do
# diretório de trabalho e criaria um banco novo.
# DATABASE_URL=sqlite:////caminho/absoluto/para/database/very_easy_calc.db

# Backend (dev: 8001; a porta 8000 é de OUTRO serviço nesta máquina)
API_HOST=0.0.0.0
API_PORT=8001
# Origens CORS permitidas para acesso direto à API (sem "*")
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.0.23:5173

# Frontend (Vite) — configurado em frontend/.env, NÃO neste arquivo:
# - VITE_API_BASE_URL vazio => requisições same-origin (/api/...)
# - VITE_API_PROXY_TARGET=http://127.0.0.1:8001 => alvo do proxy do Vite
