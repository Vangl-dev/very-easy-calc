# Very Easy Calc — exemplo de configuração
# Copie para .env e ajuste. NUNCA versione o arquivo .env real.

# Identificação
APP_NAME=Very Easy Calc
APP_VERSION=1.0.0

# Banco (SQLite por padrão; a arquitetura permite PostgreSQL)
DATABASE_URL=sqlite:///./database/very_easy_calc.db

# Backend
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
