# Very Easy Calc — frontend (Vite) em modo desenvolvimento
# Base vazia = requisições same-origin (/api/...), repassadas pelo proxy do
# Vite ao backend. Funciona em localhost e pelo IP da rede local, sem CORS.
VITE_API_BASE_URL=
# Alvo do proxy do Vite (configurado em vite.config.ts, não exposto ao navegador).
# Nesta máquina a porta 8000 está ocupada por OUTRO serviço.
VITE_API_PROXY_TARGET=http://127.0.0.1:8001
